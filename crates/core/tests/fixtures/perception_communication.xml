<?xml version="1.0"?>
<runscript name="Measured contact feedback and radio auction contracts">
  <run start="0" end="2" dt="0.25" enable_gui="false" />
  <seed>${seed=12345}</seed><end_condition>time</end_condition>
  <network>LocalNetwork</network>
  <network range="${range=100}" prob_transmit="${probability=1}">SphereNetwork</network>
  <entity_interaction remove_at_s="${remove_at=100}">RemoveContacts</entity_interaction>
  <entity_common name="agent">
    <count>1</count><y>0</y><z>0</z><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy auction_duration_s="${duration=0.5}">AuctionAssign</autonomy>
    <autonomy follow="${follow=false}">ContactFollower</autonomy>
    <controller>SingleIntegratorControllerSimple</controller><motion_model>SingleIntegrator</motion_model>
    <sensor pos_noise_0="${noise=2 0}" pos_noise_1="0 0" pos_noise_2="0 0"
            vel_noise_0="0 0" vel_noise_1="0 0" vel_noise_2="0 0">NoisyContacts</sensor>
    <sensor>Observer</sensor>
  </entity_common>
  <entity entity_common="agent"><team_id>1</team_id><x>0</x></entity>
  <entity entity_common="agent"><team_id>2</team_id><x>50</x>
    <generate_rate>1</generate_rate><generate_count>1</generate_count>
    <generate_start_time>${spawn_at=0}</generate_start_time>
  </entity>
  <entity entity_common="agent"><team_id>3</team_id><x>200</x>
    <generate_rate>1</generate_rate><generate_count>1</generate_count>
    <generate_start_time>${spawn_at=0}</generate_start_time>
  </entity>
</runscript>
