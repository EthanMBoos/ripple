<?xml version="1.0"?>
<runscript name="Plugin contract regression fixture">
  <run start="0" end="1" dt="0.1" enable_gui="false" time_warp="0" />
  <seed>12345</seed>
  <end_condition>time</end_condition>
  <network>LocalNetwork</network>
  <network delay_s="${delay_s=0}" drop_messages="${drop_messages=false}">${network=ExampleNetwork}</network>
  <entity_interaction>${interaction=Floor}</entity_interaction>
  <metrics>${metrics=PopulationMetrics}</metrics>
  <metrics>${metrics=PopulationMetrics}</metrics>
  <entity>
    <team_id>1</team_id><count>8</count>
    <x>0</x><y>0</y><z>-1</z>
    <visual_model>sphere</visual_model>
    <autonomy goal_world_m="1">DriveToGoal</autonomy>
    <controller gain="2">ScaleSpeed</controller>
    <controller gain="0.5">ScaleSpeed</controller>
    <motion_model>${motion=EastwardMotion}</motion_model>
    <!-- One parameter for whichever test sensor is selected: PositionSensor's bias_m
         or LifecycleSensor's action. Plugins reject parameters they don't read. -->
    <sensor ${sensor_key=bias_m}="${sensor_value=0}">${sensor=PositionSensor}</sensor>
  </entity>
</runscript>
