<?xml version="1.0"?>
<runscript name="Plugin defaults and overrides">
  <run start="0" end="0.3" dt="0.1" enable_gui="false" />
  <seed>12345</seed>
  <network>LocalNetwork</network>
  <network>GlobalNetwork</network>
  <entity_interaction>SimpleCollision</entity_interaction>
  <metrics>SimpleCollisionMetrics</metrics>
  <param_common name="aircraft">
    <max_roll>19</max_roll>
    <min_velocity>16</min_velocity>
  </param_common>
  <entity>
    <team_id>1</team_id><count>1</count>
    <x>0</x><y>0</y><z>100</z>
    <autonomy>Straight</autonomy>
    <controller>SimpleAircraftControllerPID</controller>
    <motion_model>SimpleAircraft</motion_model>
    <sensor>NoisyPosition</sensor>
  </entity>
  <entity>
    <team_id>2</team_id><count>1</count>
    <x>100</x><y>0</y><z>100</z>
    <autonomy speed="${speed=26}">Straight</autonomy>
    <controller>SimpleAircraftControllerPID</controller>
    <motion_model param_common="aircraft" max_roll="23">SimpleAircraft</motion_model>
    <sensor stddev_m="0">NoisyPosition</sensor>
  </entity>
</runscript>
