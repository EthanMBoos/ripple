#!/bin/sh
#
# @name Rascal (Ripple)
#
# PX4's own Rascal airframe (1033_jsbsim_rascal), as flown by its JSBSim
# bridge, plus what Ripple's FixedWing6DOF Rascal needs. Every line is a
# default, so a mission's px4_params (PX4_PARAM_* in the environment, which
# PX4's startup applies as set values) win over any of them.

. ${R}etc/init.d/rc.fw_defaults

# The fixed-wing control allocator. Without it PX4 allocates for a multirotor
# and the control surfaces get no commands at all; PX4's hardware plane
# airframes set it, the JSBSim Rascal file does not.
param set-default CA_AIRFRAME 1

param set-default FW_LND_ANG 5
param set-default FW_LND_FL_PMIN 9.5
param set-default FW_LND_FL_PMAX 20
param set-default FW_LND_FLALT 5

param set-default NPFG_PERIOD 25

param set-default FW_PR_FF 0.4
param set-default FW_PR_I 0.05
param set-default FW_PR_P 0.05

param set-default FW_R_TC 0.45
param set-default FW_RR_FF 0.4
param set-default FW_RR_I 0.132
param set-default FW_RR_P 0.085

# No wheel controller: the Rascal's tail wheel follows the rudder, as on the
# ArduPlane twin. PX4 takes the wheel's heading when the landing starts, which
# on the runway circuit is mid-turn onto final, so it landed hard over. Output
# 4 still carries the wheel for a mission that turns this on (px4_params) with
# a wheel `steered_by_input`.
param set-default FW_W_EN 0

param set-default MIS_TAKEOFF_ALT 20

param set-default NAV_ACC_RAD 15

param set-default RWTO_TKOFF 1
param set-default RWTO_PSP 8

param set-default CA_ROTOR_COUNT 1
param set-default CA_ROTOR0_PX 0.3

param set-default CA_SV_CS_COUNT 6
param set-default CA_SV_CS0_TRQ_R -0.5
param set-default CA_SV_CS0_TYPE 1
param set-default CA_SV_CS1_TRQ_R 0.5
param set-default CA_SV_CS1_TYPE 2
param set-default CA_SV_CS2_TRQ_P 1
param set-default CA_SV_CS2_TYPE 3
param set-default CA_SV_CS3_TRQ_Y 1
param set-default CA_SV_CS3_TYPE 4
param set-default CA_SV_CS4_TYPE 9
param set-default CA_SV_CS5_TYPE 10
param set-default PWM_MAIN_FUNC3 204
# Output 4 drives the steered tail wheel (function 440, Landing Gear Wheel)
# instead of the left flap, which the Rascal does not use.
param set-default PWM_MAIN_FUNC4 440
param set-default PWM_MAIN_FUNC5 101
param set-default PWM_MAIN_FUNC6 201
param set-default PWM_MAIN_FUNC7 202
param set-default PWM_MAIN_FUNC8 203
param set-default PWM_MAIN_FUNC9 206
# Reversed outputs, as a bit mask (bit n-1 for output n): the rudder (3), the
# tail wheel (4), the left aileron (6), and the elevator (8), plus the right
# flap (9) from the original file. PX4's JSBSim bridge reverses the same
# three surfaces for this Rascal: FixedWing6DOF uses the standard sign
# convention, where positive elevator pitches the nose down and positive
# rudder yaws it left, while PX4's positive outputs mean nose up and nose
# right; its left aileron goes down to roll right. The wheel input is the
# wheel's own angle, positive right, and a tail wheel turned right swings the
# tail right and the nose left, so PX4's "steer right" is reversed too (a nose
# wheel would not be). Reversed here only, so Px4Bridge's maps stay plain.
param set-default PWM_MAIN_REV 428

# Ripple's additions.
# No sticks: the session script is the only ground station and sends no manual
# control, so PX4 skips its stick checks. (It still boots into Hold for want
# of sticks; session.py moves it to Stabilized before flight.)
param set-default COM_RC_IN_MODE 4
# The Rascal's speeds. The ArduPlane twin sets the same minimum (rascal.parm):
# FixedWing6DOF's Rascal stalls near 8.3 m/s level and cruises near 20, so
# PX4's defaults (10, 15, 20) would fly it slow and let a turn stall it.
param set-default FW_AIRSPD_STALL 10
param set-default FW_AIRSPD_MIN 15
param set-default FW_AIRSPD_TRIM 20
param set-default FW_AIRSPD_MAX 30
# No range finder: land by the barometric height, not terrain.
param set-default FW_LND_USETER 0
# Missions need neither a takeoff nor a landing item (rc.fw_defaults requires a
# landing), so a looping route is accepted.
param set-default MIS_TKO_LAND_REQ 0
# The session script is the only ground station and sends no RC; losing its
# link must not trigger a return (1033 set NAV_DLL_ACT 2).
param set-default NAV_DLL_ACT 0
param set-default NAV_RCL_ACT 0
