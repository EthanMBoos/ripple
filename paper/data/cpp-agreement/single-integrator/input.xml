<?xml version="1.0"?>
<!-- Added verification fixture. ConstantVelocity (a test driver present in both
     implementations; reference/fixtures/ for C++) feeds the unmodified
     SingleIntegratorControllerSimple and SingleIntegrator. The four agents cover
     direct velocity (max_speed < 0), normalization to max_speed with a vertical
     component, a zero command with max_speed >= 0 (NaN guard), and a heading in
     another quadrant. Distinct fixed starts; no randomized state. -->
<runscript name="SingleIntegrator command paths">
  <run start="0" end="5" dt="0.1" motion_multiplier="2"
       enable_gui="false" network_gui="false" start_paused="false" time_warp="0" />
  <seed>7</seed>
  <end_condition>time</end_condition>
  <output_type>all</output_type>
  <create_latest_dir>false</create_latest_dir>
  <network>GlobalNetwork</network>
  <network>LocalNetwork</network>
  <metrics>SimpleCollisionMetrics</metrics>
  <entity_common name="point">
    <count>1</count><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <controller>SingleIntegratorControllerSimple</controller>
    <visual_model>sphere</visual_model>
  </entity_common>
  <entity entity_common="point">
    <team_id>1</team_id><x>0</x><y>0</y><z>10</z>
    <autonomy velocity="3 4 0">ConstantVelocity</autonomy>
    <motion_model max_speed="-1">SingleIntegrator</motion_model>
  </entity>
  <entity entity_common="point">
    <team_id>1</team_id><x>100</x><y>0</y><z>10</z>
    <autonomy velocity="3 4 12">ConstantVelocity</autonomy>
    <motion_model max_speed="5">SingleIntegrator</motion_model>
  </entity>
  <entity entity_common="point">
    <team_id>2</team_id><x>200</x><y>0</y><z>10</z>
    <autonomy velocity="0 0 0">ConstantVelocity</autonomy>
    <motion_model max_speed="2">SingleIntegrator</motion_model>
  </entity>
  <entity entity_common="point">
    <team_id>2</team_id><x>300</x><y>0</y><z>10</z>
    <autonomy velocity="-2 1 -1" loop_rate="2">ConstantVelocity</autonomy>
    <motion_model max_speed="-1">SingleIntegrator</motion_model>
  </entity>
</runscript>
