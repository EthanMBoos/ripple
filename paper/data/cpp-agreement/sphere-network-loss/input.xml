<?xml version="1.0"?>
<!-- Added verification fixture: SphereNetwork loss, compared draw for draw.
     Eight stationary agents within range run AuctionAssign on
     CommsNetwork with prob_transmit 0.5, so about half the start and bid
     messages are lost. Each loss draw is keyed by the sending and receiving
     entities, the topic, and the message's sequence, so external verification
     that draws the same keys must deliver exactly the same messages; random
     bid values are not compared. -->
<runscript name="SphereNetwork loss through an auction">
  <run start="0" end="7" dt="0.1"
       enable_gui="false" network_gui="false" start_paused="false" time_warp="0" />
  <seed>11</seed>
  <end_condition>time</end_condition>
  <output_type>all</output_type>
  <create_latest_dir>false</create_latest_dir>
  <network>GlobalNetwork</network>
  <network name="CommsNetwork" range="100" prob_transmit="0.5">SphereNetwork</network>
  <metrics>SimpleCollisionMetrics</metrics>
  <entity_common name="bidder">
    <team_id>1</team_id><count>1</count><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy network_name="CommsNetwork">AuctionAssign</autonomy>
    <controller>SingleIntegratorControllerSimple</controller>
    <motion_model>SingleIntegrator</motion_model>
    <visual_model>sphere</visual_model>
  </entity_common>
  <entity entity_common="bidder"><x>0</x><y>0</y><z>0</z></entity>
  <entity entity_common="bidder"><x>10</x><y>0</y><z>0</z></entity>
  <entity entity_common="bidder"><x>20</x><y>0</y><z>0</z></entity>
  <entity entity_common="bidder"><x>30</x><y>0</y><z>0</z></entity>
  <entity entity_common="bidder"><x>0</x><y>10</y><z>0</z></entity>
  <entity entity_common="bidder"><x>0</x><y>20</y><z>0</z></entity>
  <entity entity_common="bidder"><x>0</x><y>30</y><z>0</z></entity>
  <entity entity_common="bidder"><x>10</x><y>10</y><z>0</z></entity>
</runscript>
