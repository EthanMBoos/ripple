<?xml version="1.0"?>
<!-- Constant controls: every AircraftPIDController gain is zero, so surfaces
     and throttle stay at zero and only the motion model's integration varies.
     thrust_min is 0 so that zero throttle means no thrust: a glider. -->
<runscript name="fixed-wing-open-loop">
  <run start="0" end="60" dt="0.05" enable_gui="false" start_paused="false" time_warp="0" />
  <seed>12345</seed><end_condition>time</end_condition><output_type>all</output_type>
  <network>LocalNetwork</network><network>GlobalNetwork</network>
  <entity>
    <count>1</count><team_id>1</team_id>
    <x>-1000</x><y>-150</y><z>1000</z>
    <vx>222</vx><vy>0</vy><vz>0</vz><heading>0</heading>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy speed="220">Straight</autonomy>
    <controller heading_pid="0 0 0 45" altitude_pid="0 0 0 10" speed_pid="0 0 0 10" pitch_pid="0 0 0 9" roll_pid="0 0 0 9">AircraftPIDController</controller>
    <motion_model thrust_min="0">FixedWing6DOF</motion_model><visual_model>sphere</visual_model>
  </entity>
</runscript>
