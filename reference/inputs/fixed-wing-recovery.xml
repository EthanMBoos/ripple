<?xml version="1.0"?>
<!-- A gentle pitch loop recovering from a roll and pitch upset in wind. The
     altitude gains are written out (the Rust default) because upstream C++ has
     a different default; reference/rk4_loads.py flies this in both. -->
<runscript name="fixed-wing-recovery">
  <run start="0" end="30" dt="0.01" enable_gui="false" start_paused="false" time_warp="0" />
  <seed>12345</seed><end_condition>time</end_condition><output_type>all</output_type>
  <network>LocalNetwork</network><network>GlobalNetwork</network>
  <entity>
    <count>1</count><team_id>2</team_id>
    <x>200</x><y>-1000</y><z>1100</z>
    <vx>0</vx><vy>222</vy><vz>0</vz><heading>90</heading><roll>20</roll><pitch>8</pitch>
    <variance_x>0</variance_x><variance_y>0</variance_y><variance_z>0</variance_z>
    <autonomy speed="220">Straight</autonomy>
    <controller airframe="a4d" pitch_pid="0.5, 0, 0.1, 9" altitude_pid="0.1, 0.0001, 0.002, 10">AircraftPIDController</controller>
    <motion_model airframe="a4d" wind_E="-3" wind_N="2">FixedWing6DOF</motion_model><visual_model>sphere</visual_model>
  </entity>
</runscript>
